{
  "name": "wxlike-ui",
  "version": "0.1.0",
  "private": true,
  "description": "wxlike desktop frontend (WP-11): TypeScript + jotai, bundled by esbuild into dist/ for Tauri",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/main.ts --bundle --format=iife --outfile=dist/app.js --minify",
    "dev": "esbuild src/main.ts --bundle --format=iife --outfile=dist/app.js --watch",
    "build:web": "bash ../scripts/build-web.sh",
    "test:wire": "node src/web/wire.selftest.mjs",
    "check:msgindex": "bash scripts/check-msgindex.sh"
  },
  "dependencies": {
    "jotai": "^2.10.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
