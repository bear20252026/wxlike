{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wxlike",
  "version": "0.1.0",
  "identifier": "dev.wxlike.ui",
  "build": {
    "frontendDist": "../../apps/desktop-web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "wxlike",
        "width": 1180,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
