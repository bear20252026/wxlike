{
  "name": "resources/read 读动作目录",
  "description": "AI 可以像读文档一样读目录、覆盖表与单条动作 schema。",
  "setup": { "convs": [], "write": false, "destructive": false, "initialize": true },
  "request": {
    "jsonrpc": "2.0",
    "id": 7,
    "method": "resources/read",
    "params": { "uri": "wxlike://catalog" }
  },
  "expect": {
    "equals": {
      "result.contents.0.uri": "wxlike://catalog",
      "result.contents.0.mimeType": "application/json"
    },
    "contains_text": ["conv.list", "msg.send"]
  }
}
