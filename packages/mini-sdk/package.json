{
  "name": "@wxlike/mini-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed guest SDK for the wxlike mini-app host bridge (mini-host.v1)",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/types.d.ts",
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "import": "./src/index.js"
    },
    "./generated": {
      "types": "./src/generated.d.ts",
      "import": "./src/generated.js"
    }
  },
  "files": [
    "src",
    "scripts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "test": "node --test"
  }
}
