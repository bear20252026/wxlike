# 生产环境变量模板。
#
#   install -m 600 deploy/production/wxlike.env.example deploy/production/wxlike.env
#   # 逐项替换 CHANGE_ME_lowercase_random；任何 CHANGE_ME 值都会被容器自检拒绝
#
# 真实取值只存在于部署主机的 0600 文件和密钥管理器中，不进入 git、不进入
# CI 日志。发布流水线用 `deploy/production/check-log-redaction.py` 扫描采集到的日志。

# 不可变镜像引用；发布 job 产出的 manifest 记录 digest，禁止使用 latest。
WXLIKE_IMAGE=ghcr.io/bear20252026/wxlike-server@sha256:CHANGE_ME_64_hex_digest

WXLIKE_HUB_ID=hub-1
WXLIKE_LOG=wxlike_server=info
WXLIKE_SHUTDOWN_GRACE=20
WXLIKE_PUSH_WINDOW_MS=1500

# 消息总线：生产使用受管 Redis。
WXLIKE_MQ=redis
WXLIKE_REDIS_URL=redis://redis.internal:6379

# 直播推流密钥；缺失或为 CHANGE_ME 时 server 拒绝启动。
WXLIKE_LIVE_INGEST_SECRET=CHANGE_ME_live_ingest_secret

# 媒体对象下载短期链接的 HMAC 密钥（/api/v1 与 /api/media 两条面共用同一把）。
# 缺失即拒绝启动，除非显式 WXLIKE_DEV_INSECURE=1；少于 32 字节装配报错。
# 多实例必须是同一个值，否则 A 实例签的链接在 B 实例验不过。
WXLIKE_MEDIA_SECRET=CHANGE_ME_32_bytes_media_signing_key

# 管理/回调接口令牌。不设则相关端点关闭。
WXLIKE_ADMIN_TOKEN=CHANGE_ME_admin_token
WXLIKE_VIDEO_CALLBACK_TOKEN=CHANGE_ME_callback_token
WXLIKE_VIDEO_CALLBACK_ALLOW=https://video-provider.internal
WXLIKE_VIDEO_CALLBACK_ALLOW_PRIVATE=0

# 通话。TURN 使用 coturn static-auth-secret，按用户签发短期凭据。
WXLIKE_STUN_URL=stun:stun.internal:3478
WXLIKE_TURN_URL=turn:turn.internal:3478
WXLIKE_TURN_SECRET=CHANGE_ME_turn_secret
WXLIKE_SFU_ADVERTISE=203.0.113.10
WXLIKE_SFU_PORT=40000

# 观测：结构化日志字段与脱敏规则见 deploy/production/observability.md。
WXLIKE_DEV_INSECURE=0
