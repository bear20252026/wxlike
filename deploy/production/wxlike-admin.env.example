# adminx（wxlike-admin）生产环境变量模板。
#
#   install -m 600 deploy/production/wxlike-admin.env.example deploy/production/wxlike-admin.env
#   # 逐项替换 CHANGE_ME_*
#
# 只被 containers/server/compose.prod.yml 的 adminx 服务读取（env_file），
# 同时作为 `docker compose --env-file` 的插值来源（镜像引用与两个令牌）。
# 真实取值只存在于部署主机的 0600 文件中，不进入 git、不进入 CI 日志。

# adminx 镜像的不可变引用；发布 job 产出的 manifest 记录 digest，禁止 latest。
WXLIKE_ADMIN_IMAGE=ghcr.io/bear20252026/wxlike-admin@sha256:CHANGE_ME_64_hex_digest

# 读面令牌。**缺失或全空白 → adminx 拒绝启动**：这个后台能读全体用户/群/
# 审计/工单，不允许无令牌运行。生成：wxlike-admin rand-token。
WXLIKE_ADMIN_TOKEN=CHANGE_ME_admin_read_token

# 平台 x-admin-token。必须是 identity 域签发的 **Admin audience 会话令牌**
# （见 PR #453 与 crates/platform/src/identity_admin.rs）：静态
# WXLIKE_ADMIN_TOKEN 打 /api/admin/identity/* 治理端点一律 401，普通用户令牌
# 同样进不来。adminx 的写操作经此令牌转发，配错会让写面 502/401。
WXLIKE_ADMIN_PLATFORM_TOKEN=CHANGE_ME_admin_audience_session_token

# 平台库（**只读**）。adminx 以 SQLITE_OPEN_READ_ONLY + PRAGMA query_only
# 打开，不写它；adminx 自己的账号/会话/留痕库是 WXLIKE_ADMIN_DB。
# 与 server 共享同一个 /data 卷（不同文件）：SQLite WAL 的 -shm 兄弟文件
# 必须与库同目录，挂成 :ro 会让 adminx 的 query_only 回退路径失效。
WXLIKE_DB=/data/wxlike.db
WXLIKE_ADMIN_DB=/data/adminx.db

# 平台 HTTP 地址（compose 网络里的服务名）。
WXLIKE_PLATFORM_URL=http://server:8099

# 容器内监听：必须 0.0.0.0 才能被端口映射；主机侧只映射 127.0.0.1。
WXLIKE_ADMIN_BIND=0.0.0.0:8090

# 可选：工单超时口径 / 后台会话时长 / 关闭排空上限。
# WXLIKE_ADMIN_REPORT_SLA_MS=86400000
# WXLIKE_ADMIN_SESSION_TTL_MS=28800000
# WXLIKE_ADMIN_SHUTDOWN_GRACE=10
