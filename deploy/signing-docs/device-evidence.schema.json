{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wxlike.dev/schemas/device-evidence-v1.json",
  "title": "wxlike mobile device evidence",
  "type": "object",
  "required": ["schema_version", "build", "devices"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "build": {
      "type": "object",
      "required": ["git_sha", "version", "artifact_sha256"],
      "additionalProperties": false,
      "properties": {
        "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\+[0-9]+$"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "platform", "model", "os_version", "results"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "platform": {"enum": ["android", "ios"]},
          "model": {"type": "string", "minLength": 2},
          "os_version": {"type": "string", "minLength": 1},
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["feature", "status", "evidence", "observed_at"],
              "additionalProperties": false,
              "properties": {
                "feature": {"enum": ["push", "call", "webview", "permissions", "reconnect"]},
                "status": {"enum": ["pass", "fail"]},
                "evidence": {"type": "string", "minLength": 1},
                "observed_at": {"type": "string", "format": "date-time"},
                "notes": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
