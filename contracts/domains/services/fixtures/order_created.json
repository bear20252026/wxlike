      "confirmed_amount_minor": 5000,
      "params": { "account_no": "138****0001", "amount_minor": 5000 }
    },
    "expected": {
      "order_id": "ord-<opaque>",
      "state": "paid",
      "payment_id": "pay-<opaque>",
      "events": [{ "state": "created" }, { "state": "paid" }]
    }
